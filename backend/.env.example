# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URL (port 6543) for serverless/Edge; direct URL (port 5432) for Node
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ─── Admin Registration ───────────────────────────────────────────────────────
# Secret key required when calling POST /api/auth/register to create admin accounts
# Change this to something long and random; keep it private
ADMIN_REGISTER_SECRET=change_this_admin_secret_key
